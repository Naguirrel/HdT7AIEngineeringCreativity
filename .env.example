# Copia este archivo como .env y reemplaza los valores con los de tu proveedor.
# Nunca publiques el archivo .env ni una API key real.
# Cualquier proveedor compatible con la API de OpenAI Chat Completions funciona (Groq, OpenAI, etc.).
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Solo para las assertions factuality de Promptfoo; puede igualar LLM_MODEL.
LLM_GRADER_MODEL=qwen/qwen3.8-27b

# Opcional. La ruta predeterminada ya apunta al FAQ incluido en data/.
# FAQ_PATH=data/FAQs_Parachute_SA_Guatemala_2026.txt
